# Optional only. Do not commit your real .env file.
#
# Store provider API keys in a separate Subfinder provider configuration YAML with
# permissions restricted to its owner, then point to that file here. This script
# never prints this path's contents or environment values.
# SUBFINDER_PROVIDER_CONFIG="/home/your-user/.config/subfinder/provider-config.yaml"
#
# Set this only if you use a custom regular Subfinder config file.
# SUBFINDER_CONFIG="/home/your-user/.config/subfinder/config.yaml"
